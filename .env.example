# ============================================================
#  .env.example — Copy file này thành .env và điền giá trị
#  cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas hoặc local)
DATABASE="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority"

# ── JWT ──────────────────────────────────────────────────────
# Chuỗi bí mật dùng để ký JWT token (đặt chuỗi ngẫu nhiên dài)
JWT_SECRET="your_jwt_secret_key_here"

# ── Gmail (Nodemailer) ────────────────────────────────────────
# Tài khoản Gmail dùng để gửi email
GMAIL_USER="your_email@gmail.com"
# App Password của Gmail (không phải mật khẩu thường)
# Tạo tại: https://myaccount.google.com/apppasswords
GMAIL_PASS="xxxx xxxx xxxx xxxx"

# ── Cloudinary ───────────────────────────────────────────────
# Đăng ký tại: https://cloudinary.com
CLOUDINARY_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── ZaloPay ──────────────────────────────────────────────────
# Lấy thông tin tại: https://developers.zalopay.vn
# Sandbox AppID: 2554
ZALOPAY_APPID="2554"
ZALOPAY_KEY1="your_zalopay_key1"
ZALOPAY_KEY2="your_zalopay_key2"
# Sandbox endpoint
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/create"
# Production endpoint (bo comment khi deploy)
# ZALOPAY_ENDPOINT="https://openapi.zalopay.vn/v2/create"

# ── VNPAY ────────────────────────────────────────────────────
# Lay thong tin tai: https://sandbox.vnpayment.vn/
VNPAY_TMNCODE="your_vnpay_tmncode"
VNPAY_SECRET_KEY="your_vnpay_secret_key"
# Sandbox URL
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# Production URL (bo comment khi deploy)
# VNPAY_URL="https://pay.vnpay.vn/vpcpay.html"

# ── Domain ───────────────────────────────────────────────────
# URL goc cua website (dung cho callback payment)
# Khi dev local co the dung ngrok: https://ngrok.com
DOMAIN_WEBSITE="https://your-domain.com"