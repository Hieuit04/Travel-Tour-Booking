mixin product-item(item)
  .swiper-slide
    .product-item
      a.inner-image(href=`/tour/detail/${item.slug}`)
        img(
          alt=item.tourName
          src=item.avatar
          )
      .inner-content
        .inner-discount
          i.fa-solid.fa-bolt
          | Giảm #{item.discount} %
        h3.inner-title
          a(href=`/tour/detail/${item.slug}`) #{item.tourName}
        .inner-prices
          .inner-price-old
            del #{item.priceAdult.toLocaleString("vi-VN")}
            span đ
          .inner-price-new
            | #{item.newPriceAdult.toLocaleString("vi-VN")}
            span đ
        .inner-desc
          //- div
          //-   | Mã Tour:
          //-   b 123456789
          div
            | Ngày Khởi Hành:
            b #{item.departureDateFormat}
          div
            | Thời Gian:
            b #{item.time}
        .inner-footer
          .inner-rating
            .inner-stars
              i.fa-solid.fa-star
              i.fa-solid.fa-star
              i.fa-solid.fa-star
              i.fa-solid.fa-star
              i.fa-regular.fa-star
            .inner-number (5)
          .inner-stock
            .inner-label Số chỗ còn:
            .inner-number #{item.stockAdult}