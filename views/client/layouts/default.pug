html 
  head  
    title #{pageTitle}
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0" 
      name="viewport"
      )
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
      rel="stylesheet"
      )
    link(
      rel="stylesheet" 
      href="https://unpkg.com/aos@2.3.1/dist/aos.css"
      )
    link(
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" 
      rel="stylesheet"
      )
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.12.0/viewer.css" 
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/style.css" 
      rel="stylesheet"
      )
  body 
    include ../partials/top-header.pug
    include ../partials/header.pug
    block main 

    include ../partials/footer.pug

    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script(src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.12.0/viewer.js")
    script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
    script(src="/client/assets/js/script.js")