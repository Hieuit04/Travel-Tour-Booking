// Header
header.header
  .container
    .inner-wrap
      .inner-button-menu
        img(
          alt="Menu" 
          src="/client/assets/images/icon-menu.svg"
          )
      a.inner-logo(href="/")
        img(
          alt=settingWebsiteInfo.nameWebsite
          src=settingWebsiteInfo.logo
          )
      .inner-menu-overlay
      nav.inner-menu
        ul
          li
            a.inner-active(href="/") Trang Chủ
          each item in categoryTree
            if(item.status == "active")
              li
                a(href=`/category/${item.slug}`) #{item.categoryName}
                if(item.children && item.children.length > 0)
                  i.fa-solid.fa-caret-down
                ul
                  each itemChild in item.children
                    if(item.status == "active")
                      li
                        a(href=`/category/${itemChild.slug}`) #{itemChild.categoryName}
          li
            a(href="#") Tin Tức
          li
            a(href="#") Liên Hệ
      a.inner-cart(href="/cart")
        img.inner-icon-cart(
          alt="Cart" 
          src="/client/assets/images/icon-cart.svg"
          )
        img.inner-icon-arrow(
          alt="Cart Arrow" 
          src="/client/assets/images/icon-cart-arrow.svg"
          )
        div(miniCart) 0
      if account
        .user-account
          .inner-login.user-logged
            img.inner-icon-login(
              alt=account.fullName
              src=account.avatar || "/client/assets/images/icon-account.svg"
            )
            span.user-fullname= account.fullName
          .user-dropdown
            a(href="/profile") Thông tin cá nhân
            a(href="/order") Đơn hàng đã đặt
            a(href="/account/logout") Đăng xuất
      else
        a.inner-login(href="/account/login")
          img.inner-icon-login(
            alt="Login"
            src="/client/assets/images/icon-account.svg"
    )

// End Header