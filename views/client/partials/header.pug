// Header
header.header
  .container
    .inner-wrap
      .inner-button-menu
        img(
          alt="Menu" 
          src="/client/assets/images/icon-menu.svg"
          )
      a.inner-logo(href="/")
        img(
          alt=settingWebsiteInfo.nameWebsite
          src=settingWebsiteInfo.logo
          )
      .inner-menu-overlay
      nav.inner-menu
        ul
          li
            a.inner-active(href="/") Trang Chủ
          each item in categoryTree
            if(item.status == "active")
              li
                a(href=`/category/${item.slug}`) #{item.categoryName}
                if(item.children && item.children.length > 0)
                  i.fa-solid.fa-caret-down
                ul
                  each itemChild in item.children
                    if(item.status == "active")
                      li
                        a(href=`/category/${itemChild.slug}`) #{itemChild.categoryName}
          li
            a(href="#") Tin Tức
          li
            a(href="#") Liên Hệ
      a.inner-cart(href="/cart")
        img.inner-icon-cart(
          alt="Cart" 
          src="/client/assets/images/icon-cart.svg"
          )
        img.inner-icon-arrow(
          alt="Cart Arrow" 
          src="/client/assets/images/icon-cart-arrow.svg"
          )
        div(miniCart) 0
// End Header