extends ../layouts/default.pug
include ../mixins/breadcrumb.pug

block main 
  // Box Breadcrumb
  +breadcrumb()
  // End Box Breadcrumb
  // Section 10
  .section-10
    .container
      .inner-wrap
        .inner-left
          // Danh sách ảnh
          .box-images
            .inner-image-main
              .swiper.swiperMainSection10
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      img(src=image)
                .swiper-button-next
                .swiper-button-prev
            .inner-image-thumb
              .swiper.swiperThumbSection10
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      img(src=image)
          // Hết Danh sách ảnh
          // Thông Tin Tour
          .box-tour-info
            h2.inner-title-main Thông Tin Tour
            .inner-content !{tourDetail.information}
              img(
                alt="" 
                src="client/assets/images/demo/banner-7.jpg"
                )
            .inner-button
              button.button-outline Xem tất cả
          // Hết Thông Tin Tour
          // Lịch Trình Tour
          .box-tour-schedule
            h2.inner-title-main Lịch Trình Tour
            .inner-list
              .inner-line
              each item in tourDetail.schedule
                .inner-item
                  .inner-dot
                  h3.inner-title #{item.title}
                  .inner-content !{item.content}
              
          // End Lịch Trình Tour
        .inner-right
          // Chuyến Đi Của Bạn
          .box-tour-detail
            h2.inner-title-main Chuyến Đi Của Bạn
            .inner-product
              img(
                alt=tourDetail.tourName
                src=tourDetail.avatar
                )
              .inner-info
                .inner-title #{tourDetail.tourName}
                .inner-rating
                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-regular.fa-star
                  .inner-number 500 lượt đánh giá
            .inner-desc
              //- .inner-desc-item
              //-   i.fa-solid.fa-ticket-simple
              //-   span
              //-     | Mã Tour:
              //-     span.text-main 28T00001
              .inner-desc-item
                i.fa-solid.fa-calendar-days
                span
                  | Thời Gian:
                  span.text-main  #{tourDetail.time}
              .inner-desc-item
                i.fa-solid.fa-car
                span
                  | Phương Tiện:
                  span.text-main  #{tourDetail.vihicle}
              .inner-desc-item
                i.fa-solid.fa-calendar-days
                span
                  | Ngày Khởi Hành:
                  span.text-main  #{tourDetail.departureDateFormat}
            .inner-group
              label.inner-label(for="") Khởi Hành Tại:
              select(name="")
                each city in cityList
                  option(value=city._id) #{city.name}
            .inner-group
              label.inner-label(for="") Số Lượng Hành Khách:
              .inner-list
                .inner-item
                  label(for="") Người lớn:
                  input(
                    value="1" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 1 x
                    span.text-main  #{tourDetail.newPriceAdult.toLocaleString("vi-VN")}
                .inner-item
                  label(for="") Trẻ em:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 0 x
                    span.text-main #{tourDetail.newPriceChildren.toLocaleString("vi-VN")}
                .inner-item
                  label(for="") Em bé:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                  span.inner-price
                    | 0 x
                    span.text-main #{tourDetail.newPriceBaby.toLocaleString("vi-VN")}
            .inner-total
              .inner-label Tổng cộng:
              .inner-price.text-main #{tourDetail.newPriceAdult.toLocaleString("vi-VN")}đ
            button.inner-button Thêm Vào Giỏ Hàng
          // Hết Chuyến Đi Của Bạn
  // End Section 10
