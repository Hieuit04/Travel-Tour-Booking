extends ../layouts/default.pug

block main  
  // Section 11
  .section-11(page-cart)
    .container
      .inner-wrap
        .inner-head
          h1.inner-title Giỏ hàng
          a.inner-back(href="#")
            | Quay lại mua hàng
            i.fa-solid.fa-angle-right
        .inner-tour-list(cart-list)
        .inner-coupon
          form#couponForm(action="")
            input#coupon(
              placeholder="Nhập mã giảm giá" 
              type="text" 
              name="coupon"
              )
            button Dùng Mã
        .inner-price-list
          .inner-item
            .inner-label Tổng tiền:     
            .inner-price 
              span(sub-total) 0
              span đ
          .inner-item
            .inner-label Giảm:
            .inner-price 
              span(discount) 0
              span đ
          .inner-item
            .inner-label Thanh toán:
            .inner-price-hl 
              span(total) 0
              span đ
  // End Section 11
  // Section 12
  .section-12
    .container
      form#orderForm.inner-wrap(action="")
        h2.inner-title-main Thông Tin Khách Hàng
        .inner-group-list
          .inner-group
            input#fullname(
              placeholder="Họ và tên" 
              name="fullname" 
              type="text"
              )
          .inner-group
            input#phone(
              placeholder="Số điện thoại" 
              name="phone" 
              type="text"
              )
          .inner-group.inner-group-full
            textarea(
              placeholder="Ghi chú" 
              name="note"
              )
        h2.inner-title-main Chọn phương thức thanh toán
        .inner-payment-list
          .inner-item
            input#paymentMethodMoney(
              value="money" 
              name="paymentMethod" 
              type="radio"
              )
            label(for="") Thanh toán tiền mặt khi đi tour
          .inner-item
            input#paymentMethodZalo(
              value="zalopay" 
              name="paymentMethod" 
              type="radio"
              )
            label(for="") Zalo Pay
          .inner-item
            input#paymentMethodVnpay(
              value="vnpay" 
              name="paymentMethod" 
              type="radio"
              )
            label(for="") VN Pay
          .inner-item
            input#paymentMethodBank(
              value="bank" 
              name="paymentMethod" 
              type="radio"
              )
            label(for="") Chuyển khoản ngân hàng
        .inner-bank
          .inner-title Thông tin chuyển khoản
          .inner-text
            div Ngân hàng : Vietcombank
            div Tên tài khoản: Le Van A
            div STK: 0123456789
        .inner-button
          button ĐẶT TOUR
  // End Section 12