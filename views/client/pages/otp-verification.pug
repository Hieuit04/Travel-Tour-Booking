extends ../layouts/account.pug

block main
    .form-account
        h1.inner-title Nhập mã OTP
        p.inner-desc Vui lòng nhập mã OTP để tiếp tục
        form.inner-form(id="otp-verification-form")
            .inner-group
                label.inner-label(for="email") Email *
                input(
                    type="text"
                    id="email"
                    name="email"
                    class="inner-control"
                    value=email
                    readonly
                )
            .inner-group
                label.inner-label(for="otp") Mã OTP *
                input(
                    type="text"
                    id="otp"
                    name="otp"
                    placeholder="Ví dụ: 123456"
                    class="inner-control"
                )
            button.inner-button(type="submit") Xác thực