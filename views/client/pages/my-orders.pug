extends ../layouts/default.pug

block main
  .container.page-my-orders(style="padding: 40px 15px 60px;")
    h1.box-title Đơn hàng của tôi

    //- Thanh công cụ Bộ lọc & Tìm kiếm (cùng 1 hàng, khoảng cách gọn gàng)
    .section-filter-wrap
      .section-4(style="padding-bottom: 0px")
        .inner-wrap
          .inner-item
            <i class="fa-solid fa-filter"></i> Bộ lọc
          .inner-item
            select(filter name="status")
              option(value="") Trạng thái
              each item in orderStatusList
                option(value=item.value) #{item.label}
          .inner-item
            input(filter name="startDate" type="date")
            span -
            input(filter name="endDate" type="date")
          .inner-item
            select(filter name="paymentMethod")
              option(value="") Phương thức thanh toán
              each item in paymentMethodList
                option(value=item.value) #{item.label}
          .inner-item.inner-reset(button-reset-filter)
            <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc

      .section-5(style="padding-bottom: 15px")
        form.inner-search
          button(type="submit") <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm theo mã đơn..." input-search)
    //- End Section Filter & Search

    //- Section 6: Bảng danh sách đơn hàng
    .section-6
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th(style="white-space: nowrap; text-align: center;") Trạng thái
            th(style="white-space: nowrap;") Ngày đặt
            th(style="text-align: center; white-space: nowrap;") Hành động
        tbody
          if orderList.length > 0
            each item in orderList
              tr
                td(style="white-space: nowrap;")
                  a.text-main(href=`/my-orders/${item.code}` style="font-weight: 700; color: var(--color-main, #582be8);") #{item.code}
                td
                  div Họ tên: #{item.fullName}
                  - var listPhone = item.phone.toString().startsWith("0") ? item.phone : "0" + item.phone
                  div SĐT: #{listPhone}
                  if item.note
                    div Ghi chú: #{item.note}
                td
                  .tour-list
                    each tour in item.items
                      .inner-item
                        img(src=tour.avatar onerror="this.src='https://placehold.co/140x100?text=No+Image'")
                        .inner-content
                          .inner-title #{tour.tourName}
                          .inner-desc
                            if tour.quantityAdult > 0
                              div Người lớn: #{tour.quantityAdult} x #{tour.newPriceAdult.toLocaleString("vi-VN")}đ
                            if tour.quantityChildren > 0
                              div Trẻ em: #{tour.quantityChildren} x #{tour.newPriceChildren.toLocaleString("vi-VN")}đ
                            if tour.quantityBaby > 0
                              div Em bé: #{tour.quantityBaby} x #{tour.newPriceBaby.toLocaleString("vi-VN")}đ
                            if tour.departureDate
                              div Khởi hành: #{moment(tour.departureDate).format('DD/MM/YYYY')}
                td
                  div Tổng tiền: #{item.subTotal.toLocaleString("vi-VN")}đ
                  div Giảm: #{item.discount.toLocaleString("vi-VN")}đ
                  div Thanh toán: <span class="text-red" style="font-weight: 700; color: #EF3826;">#{item.total.toLocaleString("vi-VN")}đ</span>
                  
                  - var paymentMethodItem = paymentMethodList.find(pm => pm.value === item.paymentMethod)
                  div PTTT: #{paymentMethodItem ? paymentMethodItem.label : item.paymentMethod}
                  
                td(style="white-space: nowrap; text-align: center;")
                  - var orderStatusItem = orderStatusList.find(os => os.value === item.status)
                  if item.status === "success" || item.status === "done" || item.status === "paid"
                    .tag.tag-green #{orderStatusItem ? orderStatusItem.label : item.status}
                  else if item.status === "cancel"
                    .tag.tag-red #{orderStatusItem ? orderStatusItem.label : item.status}
                  else
                    .tag.tag-orange #{orderStatusItem ? orderStatusItem.label : item.status}
                td(style="white-space: nowrap;") #{moment(item.createdAt).format('HH:mm - DD/MM/YYYY')}
                td(style="text-align: center; white-space: nowrap;")
                  .inner-action
                    a(href=`/my-orders/${item.code}` title="Xem chi tiết đơn hàng")
                      <i class="fa-regular fa-eye"></i>
          else
            tr
              td(colspan="7" style="text-align: center; padding: 40px; color: #888;")
                i.fa-solid.fa-box-open(style="font-size: 36px; margin-bottom: 10px; display: block; color: #ccc;")
                | Bạn chưa có đơn hàng nào!
    //- End Section 6

    //- Section 7: Phân trang
    .section-7
      if orderList.length > 0
        .inner-text Hiển thị #{pagination.skip + 1} - #{pagination.skip + orderList.length} của #{pagination.totalRecord} đơn hàng
        select(pagination)
          - for(let i = 1; i <= pagination.totalPages; i++)
            option(value=i selected=(i === pagination.page)) Trang #{i}
      else
        .inner-text Không tìm thấy đơn hàng nào!
    //- End Section 7
