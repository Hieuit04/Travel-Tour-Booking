            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
            .product-item Item
          .box-pagination
            button
              i.fa-solid.fa-angles-left
            button.active 1
            button 2
            button 3
            button 4
            button
              i.fa-solid.fa-angles-right
  // End Section 9
