extends ../layouts/default.pug

block main
  // Box Breadcrumb
  .box-breadcrumb
    img.inner-image(
      alt="" 
      src="/client/assets/images/demo/banner-6.jpg"
      )
    .inner-content
      .container
        h1.inner-title Tour Nước Ngoài
        .inner-list
          a(href="#") Trang Chủ
          i.fa-solid.fa-angles-right
          a(href="#") Tour Nước Ngoài
  // End Box Breadcrumb
  // Section 9
  .section-9
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          .box-filter
            .inner-head
              .inner-title Bộ Lọc
              img.inner-icon(
                alt="Filter" 
                src="client/assets/images/icon-filter.svg"
                )
            .inner-group
              label.inner-label(for="") Điểm đi
              select(name="")
                option(value="") -- Chọn điểm đi --
                option(value="") Hà Nội
                option(value="") Đà Nẵng
                option(value="") Nha Trang
            .inner-group
              label.inner-label(for="") Điểm đến
              select(name="")
                option(value="") -- Chọn điểm đến --
                option(value="") Hà Nội
                option(value="") Đà Nẵng
                option(value="") Nha Trang
            .inner-group
              label.inner-label(for="") Ngày khởi hành
              input(
                name="" 
                type="date"
                )
            .inner-group
              label.inner-label(for="") Số Lượng Hành Khách
              .inner-list
                .inner-item
                  label(for="") Người lớn:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                .inner-item
                  label(for="") Trẻ em:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
                .inner-item
                  label(for="") Em bé:
                  input(
                    value="0" 
                    name="" 
                    type="number"
                    )
            .inner-group
              label.inner-label(for="") Mức giá
              select(name="")
                option(value="") -- Chọn khoảng giá --
                option(value="") Dưới 1tr
                option(value="") Từ 1tr - 3tr
                option(value="") Từ 3tr - 6tr
                option(value="") Từ 6tr - 10tr
                option(value="") Trên 10tr
            button.inner-button Áp Dụng
          // End Box Filter
        .inner-right
          .inner-wrap-1
            h2.inner-title-main Tour Nước Ngoài
            .inner-desc
              p
