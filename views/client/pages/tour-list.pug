extends ../layouts/default.pug
include ../mixins/breadcrumb.pug
include ../mixins/product-item.pug
block main
  // Box Breadcrumb
  +breadcrumb()
  // End Box Breadcrumb
  // Section 9
  .section-9
    .container
      .inner-wrap
        .inner-left
          // Box Filter
          .box-filter
            .inner-head
              .inner-title Bộ Lọc
              img.inner-icon(
                alt="Filter" 
                src="/client/assets/images/icon-filter.svg"
                )
            .inner-group
              label.inner-label(for="") Điểm đi
              select(name="locationFrom")
                option(value="") -- Chọn điểm đi --
                each city in cityList
                  option(value=city._id) #{city.name}
            .inner-group
              label.inner-label(for="") Điểm đến
              select(name="locationTo")
                option(value="") -- Chọn điểm đến --
                each city in cityList
                  option(value=city.name) #{city.name}
            .inner-group
              label.inner-label(for="") Ngày khởi hành
              input(
                name="departureDate" 
                type="date"
                )
            .inner-group
              label.inner-label(for="") Số Lượng Hành Khách
              .inner-list
                .inner-item
                  label(for="") Người lớn:
                  input(
                    value="0" 
                    name="stockAdult" 
                    type="number"
                    )
                .inner-item
                  label(for="") Trẻ em:
                  input(
                    value="0" 
                    name="stockChildren" 
                    type="number"
                    )
                .inner-item
                  label(for="") Em bé:
                  input(
                    value="0" 
                    name="stockBaby" 
                    type="number"
                    )
            .inner-group
              label.inner-label(for="") Mức giá
              select(name="price")
                option(value="") -- Chọn khoảng giá --
                option(value="0-2000000") Dưới 2tr
                option(value="2000000-5000000") Từ 2tr - 5tr
                option(value="5000000-10000000") Từ 5tr - 10tr
                option(value="10000000-20000000") Từ 10tr - 20tr
                option(value="20000000-1000000000") Trên 20tr
            button.inner-button Áp Dụng
          // End Box Filter
        .inner-right
          .inner-wrap-1
            h2.inner-title-main 
              | #{categoryDetail.categoryName}
            .inner-desc
              | !{categoryDetail.description}
          .inner-wrap-2
            .inner-sort
              .inner-label Sắp xếp:
              a.inner-button(href="#")
                | Giá tăng dần
                i.fa-solid.fa-square-arrow-up-right
              a.inner-button(href="#")
                | Giá giảm dần
                i.fa-solid.fa-square-arrow-up-right.inner-rotate-90
              a.inner-button.active(href="#")
                | Khuyến Mại Hot
                i.fa-solid.fa-tag
              a.inner-button(href="#")
                | Xem Nhiều
                i.fa-solid.fa-eye
            .inner-total
              | Tất cả:
              b 101 Tour
            button.inner-button-filter
              | Bộ Lọc
              img(
                alt="Filter" 
                src="/client/assets/images/icon-filter.svg"
                )
          .inner-wrap-3
            each item in tourList 
              +product-item(item)
          .box-pagination
            button
              i.fa-solid.fa-angles-left
            button.active 1
            button 2
            button 3
            button 4
            button
              i.fa-solid.fa-angles-right
  // End Section 9
