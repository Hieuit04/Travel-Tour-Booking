extends ../layouts/default.pug

block main
  .container.page-my-order-detail(style="padding: 40px 15px 60px; max-width: 950px;")
    h1.box-title(style="text-align: center; margin-bottom: 24px;") Đơn hàng: #{orderDetail.code}

    //- Section 8: Giao diện chi tiết đơn hàng
    .section-8
      form
        .inner-group
          label(for="fullName" style="display: block; width: 100%; margin-bottom: 10px;") Tên khách hàng
          input(type="text" name="fullName" id="fullName" value=orderDetail.fullName readonly disabled)
        .inner-group
          label(for="phone" style="display: block; width: 100%; margin-bottom: 10px;") Số điện thoại
          - var displayPhone = orderDetail.phone.toString().startsWith("0") ? orderDetail.phone : "0" + orderDetail.phone
          input(type="text" name="phone" id="phone" value=displayPhone readonly disabled)
        .inner-group.inner-two-col(style="grid-column: 1 / -1; display: flex; flex-direction: column; width: 100%;")
          label(for="note" style="display: block; width: 100%; margin-bottom: 10px;") Ghi chú
          textarea(name="note" id="note" readonly disabled style="width: 100%;") #{orderDetail.note || "Không có ghi chú"}
        .inner-group
          label(for="paymentMethod" style="display: block; width: 100%; margin-bottom: 10px;") Phương thức thanh toán
          select(name="paymentMethod" id="paymentMethod" disabled)
            each item in paymentMethodList
              option(value=item.value selected=(orderDetail.paymentMethod === item.value)) #{item.label}
        .inner-group
          label(for="paidAt" style="display: block; width: 100%; margin-bottom: 10px;") Thời điểm thanh toán
          input(type="text" id="paidAt" value=(orderDetail.paidAt ? moment(orderDetail.paidAt).format('HH:mm - DD/MM/YYYY') : "Chưa thanh toán") readonly disabled)
        .inner-group
          label(for="orderDate" style="display: block; width: 100%; margin-bottom: 10px;") Ngày đặt
          input(type="text" id="orderDate" value=moment(orderDetail.createdAt).format('HH:mm - DD/MM/YYYY') readonly disabled)
        .inner-group
          label(for="status" style="display: block; width: 100%; margin-bottom: 10px;") Trạng thái
          select(name="status" id="status" disabled)
            each item in orderStatusList
              option(value=item.value selected=(orderDetail.status === item.value)) #{item.label}
        .inner-group.inner-two-col(style="grid-column: 1 / -1; display: flex; flex-direction: column; width: 100%;")
          label(style="display: block; width: 100%; margin-bottom: 10px;") Danh sách tour
          .tour-list.inner-large(style="width: 100%;")
            each item in orderDetail.items
              .inner-item
                img(src=item.avatar onerror="this.src='https://placehold.co/140x100?text=No+Image'")
                .inner-content
                  .inner-title #{item.tourName}
                  .inner-desc
                    if item.quantityAdult > 0
                      div Người lớn: #{item.quantityAdult} x #{item.newPriceAdult.toLocaleString("vi-VN")}đ
                    if item.quantityChildren > 0
                      div Trẻ em: #{item.quantityChildren} x #{item.newPriceChildren.toLocaleString("vi-VN")}đ
                    if item.quantityBaby > 0
                      div Em bé: #{item.quantityBaby} x #{item.newPriceBaby.toLocaleString("vi-VN")}đ
                    if item.departureDate
                      div Ngày khởi hành: #{moment(item.departureDate).format('DD/MM/YYYY')}
                    if item.cityName
                      div Khởi hành tại: #{item.cityName}
        .inner-group
          label(style="display: block; width: 100%; margin-bottom: 10px;") Thanh toán
          .inner-text
            div Tổng tiền: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
            div Giảm: #{orderDetail.discount.toLocaleString("vi-VN")}đ
            div Thanh toán: <span class="text-red" style="color: #EF3826; font-size: 18px; font-weight: 700;">#{orderDetail.total.toLocaleString("vi-VN")}đ</span>
        
        //- Nút Quay lại danh sách: Nằm chính giữa khung
        .inner-group.inner-btn-wrap(style="grid-column: 1 / -1; display: flex; justify-content: center; align-items: center; width: 100%; margin-top: 15px;")
          a.btn-create(
            href="/my-orders" 
            style="display: inline-flex; justify-content: center; align-items: center; text-decoration: none; min-width: 260px; height: 50px; font-size: 16px; font-weight: 700; border-radius: 10px; background-color: var(--color-main, #582be8); color: white; transition: opacity 0.2s;"
          ) Quay lại danh sách

      //- Nút ở dưới: Thay bằng nút "Hủy đơn hàng" (chỉ khi trạng thái là khởi tạo)
      if orderDetail.status === "initial"
        if ["zalopay", "vnpay"].includes(orderDetail.paymentMethod)
          .inner-link(style="text-align: center; margin-top: 25px; width: 100%;")
            a(
              href=`/order/payment-${orderDetail.paymentMethod}?orderCode=${orderDetail.code}&phone=${encodeURIComponent(orderDetail.phone)}`
              style="font-weight: 700; font-size: 16px; text-decoration: underline;"
            ) Thanh toán lại
        .inner-link(style="text-align: center; margin-top: 25px; width: 100%;")
          a(
            href="javascript:;" 
            button-cancel-order
            data-api=`/my-orders/cancel/${orderDetail.code}`
            style="color: #EF3826; font-weight: 700; font-size: 16px; text-decoration: underline; cursor: pointer;"
          ) Hủy đơn hàng
    //- End Section 8
