extends ../layouts/default.pug

block main
  h1.box-title Cài đặt chung

  //- Section 9
  .section-9
    if(pers.includes("website-info-view"))
      a.inner-item(href=`/${pathAdmin}/setting/website-info`)
        img(src="/admin/assets/images/section-9-icon-1.svg")
        span Thông tin website
    if(pers.includes("account-admin-view"))
      a.inner-item(href=`/${pathAdmin}/setting/account-admin/list`)
        img(src="/admin/assets/images/section-9-icon-2.svg")
        span Tài khoản quản trị
    if(pers.includes("role-list-view"))
      a.inner-item(href=`/${pathAdmin}/setting/role/list`)
        img(src="/admin/assets/images/section-9-icon-3.svg")
        span Nhóm quyền
  //- End Section 9