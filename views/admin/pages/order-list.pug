extends ../layouts/default.pug
include ../mixins/checkbox.pug


block main
  h1.box-title Quản lý đơn hàng

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select
          option(value="") Trạng thái
          option(value="") Hoạt động
          option(value="") Tạm dừng
      .inner-item
        input(type="date")
        span -
        input(type="date")
      .inner-item
        select
          option(value="") Phương thức thanh toán
          option(value="") Tiền mặt
          option(value="") ZaloPay
          option(value="") VNPay
          option(value="") Chuyển khoản
      .inner-item
        select
          option(value="") Trạng thái thanh toán
          option(value="") Chưa thanh toán
          option(value="") Đã thanh toán
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    form.inner-search
      button <i class="fa-solid fa-magnifying-glass"></i>
      input(type="text" placeholder="Tìm kiếm")
  //- End Section 5

  //- Section 6
  .section-6
    table
      thead
        tr
          th Mã
          th Thông tin khách
          th Danh sách tour
          th Thanh toán
          th Trạng thái
          th Ngày đặt
          th Hành động
      tbody
        tr
          td
            .text-main OD000001
          td
            div Họ tên: Lê Văn A
            div SĐT: 0123456789
            div Ghi chú: Test...
          td
            .tour-list
              .inner-item
                img(src="/admin/assets/images/demo-tour-1.png")
                .inner-content
                  .inner-title Tour Hạ Long
                  .inner-desc
                    div Người lớn: 3 x 1.500.000đ
                    div Trẻ em: 2 x 1.300.000đ
                    div Em bé: 2 x 1.000.000đ
              .inner-item
                img(src="/admin/assets/images/demo-tour-1.png")
                .inner-content
                  .inner-title Tour Hạ Long
                  .inner-desc
                    div Người lớn: 3 x 1.500.000đ
                    div Trẻ em: 2 x 1.300.000đ
                    div Em bé: 2 x 1.000.000đ
          td
            div Tổng tiền: 10.000.000đ
            div Giảm: 400.000đ
            div Mã giảm: TOURMUAHE2024
            div Thanh toán: 9.600.000đ
            div PTTT: Ví Momo
            div TTTT: Đã thanh toán
          td
            .tag.tag-orange Khởi tạo
            //- .tag.tag-green Đã duyệt
            //- .tag.tag-red Đã hủy
          td 16:20 - 01/01/2024
          td
            .inner-action
              a(href=`/${pathAdmin}/order/edit`) <i class="fa-regular fa-pen-to-square"></i>
              a(href="#" class="inner-remove") <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    .inner-text Hiển thị 1 - 9 của 78
    select
      option(value="") Trang 1
      option(value="") Trang 2
      option(value="") Trang 3
  //- End Section 7