extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  if(pers.includes("order-view"))
    h1.box-title Quản lý đơn hàng

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(filter name="status")
            option(value="") Trạng thái
            each item in orderStatusList
              option(value=item.value) #{item.label}
        .inner-item
          input(filter name="startDate" type="date")
          span -
          input(filter name="endDate" type="date")
        .inner-item
          select(filter name="paymentMethod")
            option(value="") Phương thức thanh toán
            each item in paymentMethodList
              option(value=item.value) #{item.label}
        .inner-item
          select(filter name="paymentStatus")
            option(value="") Trạng thái thanh toán
            each item in paymentStatusList
              option(value=item.value) #{item.label}
        .inner-item.inner-reset(button-reset-filter)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      if(pers.includes("order-edit"))
        form.inner-status(change-multi data-api=`/${pathAdmin}/order/change-multi`)
          .inner-item
            select
              option(value="") -- Hành động --
              each item in orderStatusList
                option(value=item.value) #{item.label}
              option(value="delete") Xóa
          .inner-item
            button(type="button") Áp dụng
      form.inner-search
        button <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm" input-search)
    //- End Section 5

    //- Section 6
    .section-6
      table
        thead
          tr
            th
              +checkbox-30("check-all", "")
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th Ngày đặt
            th Hành động
        tbody
          each item in orderList
            tr
              td
                +checkbox-30("check-item", "", item.id)
              td
                .text-main #{item.code}
              td
                div Họ tên: #{item.fullName}
                - var listPhone = item.phone.toString().startsWith("0") ? item.phone : "0" + item.phone
                div SĐT: #{listPhone}
                if item.note
                  div Ghi chú: #{item.note}
              td
                .tour-list
                  each tour in item.items
                    .inner-item
                      img(src=tour.avatar onerror="this.src='https://placehold.co/140x100?text=No+Image'")
                      .inner-content
                        .inner-title #{tour.tourName}
                        .inner-desc
                          if tour.quantityAdult > 0
                            div Người lớn: #{tour.quantityAdult} x #{tour.newPriceAdult.toLocaleString("vi-VN")}đ
                          if tour.quantityChildren > 0
                            div Trẻ em: #{tour.quantityChildren} x #{tour.newPriceChildren.toLocaleString("vi-VN")}đ
                          if tour.quantityBaby > 0
                            div Em bé: #{tour.quantityBaby} x #{tour.newPriceBaby.toLocaleString("vi-VN")}đ
              td
                div Tổng tiền: #{item.subTotal.toLocaleString("vi-VN")}đ
                div Giảm: #{item.discount.toLocaleString("vi-VN")}đ
                div Thanh toán: #{item.total.toLocaleString("vi-VN")}đ
                
                - var paymentMethodItem = paymentMethodList.find(pm => pm.value === item.paymentMethod)
                div PTTT: #{paymentMethodItem ? paymentMethodItem.label : item.paymentMethod}
                
                - var paymentStatusItem = paymentStatusList.find(ps => ps.value === item.paymentStatus)
                div TTTT: 
                  if item.paymentStatus === 'paid'
                    b(style="color: green;") #{paymentStatusItem ? paymentStatusItem.label : item.paymentStatus}
                  else
                    b(style="color: red;") #{paymentStatusItem ? paymentStatusItem.label : item.paymentStatus}
              td
                - var orderStatusItem = orderStatusList.find(os => os.value === item.status)
                if item.status === "success" || item.status === "done"
                  .tag.tag-green #{orderStatusItem ? orderStatusItem.label : item.status}
                else if item.status === "cancel"
                  .tag.tag-red #{orderStatusItem ? orderStatusItem.label : item.status}
                else
                  .tag.tag-orange #{orderStatusItem ? orderStatusItem.label : item.status}
              td #{moment(item.createdAt).format('HH:mm - DD/MM/YYYY')}
              td
                .inner-action
                  if(pers.includes("order-edit"))
                    a(href=`/${pathAdmin}/order/edit/${item.id}`) <i class="fa-regular fa-pen-to-square"></i>
                  if(pers.includes("order-delete"))
                    a(
                      href="javascript:;" 
                      class="inner-remove"
                      button-delete
                      data-api=`/${pathAdmin}/order/delete/${item.id}` 
                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7
      if orderList.length > 0
        .inner-text Hiển thị #{pagination.skip+1} - #{pagination.skip + orderList.length} của #{pagination.totalRecord}
        select(pagination)
          - for(let i=1; i<= pagination.totalPages; i++)
            option(value=i) Trang #{i}
      else
        .inner-text Không tìm thấy đơn hàng nào!
    //- End Section 7
