extends ../layouts/account.pug

block main
  .form-account
    h1.inner-title Đổi mật khẩu
    p.inner-desc Vui lòng nhập mật khẩu để tiếp tục
    form.inner-form(id="reset-password-form")
      .inner-group 
        label.inner-label(for="password") Mật khẩu mới *
        .inner-password
          input(
            type="password"
            id="password"
            name="password"
            placeholder="Nhập mật khẩu của bạn"
            autocomplete="current-password"
            class="inner-control"
          )
          button(
            type="button"
            class="inner-password-toggle"
            aria-label="Hiển thị mật khẩu"
          )
            i.fa-solid.fa-eye
      .inner-group 
        label.inner-label(for="confirmPassword") Xác nhận mật khẩu *
        .inner-password
          input(
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            placeholder="Nhập lại mật khẩu của bạn"
            autocomplete="current-password"
            class="inner-control"
          )
          button(
            type="button"
            class="inner-password-toggle"
            aria-label="Hiển thị mật khẩu"
          )
            i.fa-solid.fa-eye
      button.inner-button Thay đổi
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(href=`/${pathAdmin}/account/login`) Đăng nhập