extends ../layouts/default.pug

block title
  title Thông tin cá nhân

block main
  h1.box-title Thông tin cá nhân

  //- Section 8
  .section-8
    form(id="profile-edit-form")
      .inner-group
        label(for="name") Họ tên
        input(type="text" name="name" id="name")
      .inner-group
        label(for="email") Email
        input(type="email" name="email" id="email")
      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone")
      .inner-group
        label(for="position") Chức vụ
        input(type="text" name="position" id="position" value="Giám đốc" readonly)
      .inner-group
        label(for="role") Nhóm quyền
        input(type="text" name="role" id="role" value="Quản trị viên" readonly)
      .inner-group.inner-two-col
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" accept="image/*" filepondImage).inner-upload-image
      .inner-group.inner-two-col.text-center
        button.btn-create(type="submit") Cập nhật
    .inner-link
      a(href="#") Đổi mật khẩu
  //- End Section 8