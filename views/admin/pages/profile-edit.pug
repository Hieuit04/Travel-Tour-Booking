extends ../layouts/default.pug

block main
  h1.box-title Thông tin cá nhân

  //- Section 8
  .section-8
    form(id="profile-edit-form")
      .inner-group
        label(for="fullName" ) Họ tên
        input(type="text" name="fullName" id="fullName" value= account.fullName)
      .inner-group
        label(for="email") Email
        input(type="email" name="email" id="email" value= account.email)
      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone" value= account.phone)
      .inner-group
        label(for="positionCompany") Chức vụ
        input(type="text" name="positionCompany" id="positionCompany" value= account.positionCompany  readonly)
      .inner-group
        label(for="role") Nhóm quyền
        input(type="text" name="role" id="role" value=role.roleName readonly)
      .inner-group.inner-two-col
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" accept="image/*" filepondImage image-default=account.avatar).inner-upload-image
      .inner-group.inner-two-col.text-center
        button.btn-create(type="submit") Cập nhật
    .inner-link
      a(href=`/${pathAdmin}/profile/change-password`) Đổi mật khẩu
  //- End Section 8