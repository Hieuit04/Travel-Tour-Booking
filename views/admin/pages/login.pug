extends ../layouts/account.pug
include ../mixins/checkbox.pug

block main
  .form-account
    h1.inner-title Đăng nhập
    p.inner-desc Vui lòng nhập email và mật khẩu để tiếp tục
    form.inner-form(id="login-form")
      .inner-group 
        label.inner-label(for="email") Email *
        input(
          type="email" 
          id="email" 
          name="email" 
          autocomplete="username"
          placeholder="Nhập email của bạn" 
          class="inner-control"
        )
      .inner-group 
        label.inner-label(for="password" ) Mật khẩu *
        .inner-password
          input(
            type="password"
            id="password"
            name="password"
            placeholder="Nhập mật khẩu của bạn"
            autocomplete="current-password"
            class="inner-control"
          )
          button(
            type="button"
            class="inner-password-toggle"
            aria-label="Hiển thị mật khẩu"
          )
            i.fa-solid.fa-eye
      .inner-meta
        .inner-check
          +checkbox-30("rememberPassword", "rememberPassword")
          label(for="rememberPassword") Nhớ mật khẩu
        a(href=`/${pathAdmin}/account/forgot-password`) Quên mật khẩu?
      button.inner-button(type="submit") Đăng nhập
    .inner-more
      span Bạn chưa có tài khoản?
      a(href=`/${pathAdmin}/account/register`) Tạo tài khoản