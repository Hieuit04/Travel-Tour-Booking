extends ../layouts/default.pug

block main
  if(pers.includes("account-admin-edit"))
    h1.box-title Sửa tài khoản quản trị

    //- Section 8
    .section-8
      form(id="setting-account-admin-edit-form")
        input(type="hidden" name="id" value=accountAdminDetail.id)
        .inner-group
          label(for="fullName") Họ tên *
          input(type="text" name="fullName" id="fullName" value=accountAdminDetail.fullName)
        .inner-group
          label(for="email") Email *
          input(type="email" name="email" id="email" value=accountAdminDetail.email)
        .inner-group
          label(for="phone") Số điện thoại
          input(type="text" name="phone" id="phone" value=accountAdminDetail.phone)
        .inner-group
          label(for="role") Nhóm quyền *
          select(name="role" id="role")
            option(value="") -- Chọn nhóm quyền --
            each item in roleList
              option(value=item.id selected=(item.id == accountAdminDetail.role)) #{item.roleName}
        .inner-group
          label(for="positionCompany") Chức vụ
          input(type="text" name="positionCompany" id="positionCompany" value=accountAdminDetail.positionCompany)
        .inner-group
          label(for="status" ) Trạng thái
          select(name="status" id="status")
            option(value="initial" selected=(accountAdminDetail.status == "initial" ? true:false)) Khởi tạo 
            option(value="active" selected=(accountAdminDetail.status == "active" ? true:false)) Hoạt động
            option(value="inactive" selected=(accountAdminDetail.status == "inactive" ? true:false)) Tạm dừng
        .inner-group.inner-two-col
          label(for="avatar") Ảnh đại diện
          input(type="file" name="avatar" id="avatar" accept="image/*" filepondImage image-default= accountAdminDetail.avatar).inner-upload-image
        .inner-group.inner-two-col.text-center
          button.btn-create(type="submit") Cập nhật
      .inner-link
        a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách
    //- End Section 8