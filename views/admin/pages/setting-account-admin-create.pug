extends ../layouts/default.pug

block title
  title Tạo tài khoản quản trị

block main
  h1.box-title Tạo tài khoản quản trị

  //- Section 8
  .section-8
    form(id="setting-account-admin-create-form")
      .inner-group
        label(for="name") Họ tên
        input(type="text" name="name" id="name")
      .inner-group
        label(for="email") Email
        input(type="email" name="email" id="email")
      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone")
      .inner-group
        label(for="role") Nhóm quyền
        select(name="role" id="role")
          option(value="admin") Quản trị viên
          option(value="manager") Quản lý đơn hàng
      .inner-group
        label(for="position") Chức vụ
        input(type="text" name="position" id="position")
      .inner-group
        label(for="status") Trạng thái
        select(name="status" id="status")
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-group
        label(for="password") Mật khẩu
        input(type="text" name="password" id="password")
      .inner-group.inner-two-col
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" accept="image/*"  filepondImage).inner-upload-image
      .inner-group.inner-two-col.text-center
        button.btn-create(type="submit") Tạo mới
    .inner-link
      a(href="#") Quay lại danh sách
  //- End Section 8