extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  h1.box-title #{pageTitle}

  //- Section 5
  .section-5
    form.inner-status(change-multi data-api=`/${pathAdmin}/setting/role/change-multi`)
      .inner-item
        select
          option(value="") -- Hành động --
          option(value="delete") Xóa
      .inner-item
        button Áp dụng
    form.inner-search
      button <i class="fa-solid fa-magnifying-glass"></i>
      input(type="text" placeholder="Tìm kiếm" input-search)
    a.inner-create(href=`/${pathAdmin}/setting/role/create`) + Tạo mới
  //- End Section 5

  //- Section 6
  .section-6
    table
      thead
        tr
          th
            +checkbox-30("check-all", "")
          th Tên nhóm quyền
          th Mô tả ngắn
          th Hành động
      tbody
        each item in settingRoleList
          tr
            td
              +checkbox-30("check-item", "", item.id)
            td #{item.roleName}
            td #{item.description}
            td
              .inner-action
                a(href=`/${pathAdmin}/setting/role/edit/${item.id}`) <i class="fa-regular fa-pen-to-square"></i>
                a.inner-remove(
                  href="javascript:;" 
                  button-delete 
                  data-api=`/${pathAdmin}/setting/role/delete/${item.id}` 
                ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    .inner-text Hiển thị #{pagination.skip+1} - #{pagination.skip+settingRoleList.length} của #{pagination.totalRecord}
    select(pagination)
      - for(let i=1; i<= pagination.totalPages; i++)
        option(value=i) Trang #{i}
  //- End Section 7