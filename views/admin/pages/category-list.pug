extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  h1.box-title Quản lý danh mục

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select(filter name="status")
          option(value="") Trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item
        select(filter name="createdBy")
          option(value="") Người tạo
          each item in accountList 
            option(value=item._id) #{item.fullName}
      .inner-item
        input(type="date")
        span -
        input(type="date")
      .inner-item.inner-reset
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    form.inner-status
      .inner-item
        select
          option(value="") -- Hành động --
          option(value="") Hoạt động
          option(value="") Tạm dừng
          option(value="") Xóa
      .inner-item
        button Áp dụng
    form.inner-search
      button <i class="fa-solid fa-magnifying-glass"></i>
      input(type="text" placeholder="Tìm kiếm")
    a.inner-create(href=`/${pathAdmin}/category/create`) + Tạo mới
  //- End Section 5

  //- Section 6
  .section-6
    table
      thead
        tr
          th
            +checkbox-30("", "")
          th Tên danh mục
          th Ảnh đại diện
          th Vị trí
          th Trạng thái
          th Tạo bởi
          th Cập nhật bởi
          th Hành động
      tbody
        each item in categoryList
          tr 
            td
              +checkbox-30("", "")
            td #{item.categoryName}
            td
              img(src=item.avatar class="inner-avatar")
            td #{item.position}
            td
              if(item.status === "active")
                .tag.tag-green Hoạt động
              else if (item.status === "inactive")
                .tag.tag-red Tạm dừng
            td
              if(item.createdBy)
                div #{item.createdByName}
                .inner-time #{item.createdAtFormat}
            td
              if(item.updatedBy)
                div #{item.updatedByName}
                .inner-time #{item.updatedAtFormat}
            td
              .inner-action
                a(href=`/${pathAdmin}/category/edit/${item.id}`) <i class="fa-regular fa-pen-to-square"></i>
                a.inner-remove(
                  href="javascript:;" 
                  button-delete 
                  data-api=`/${pathAdmin}/category/delete/${item.id}` 
                ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    .inner-text Hiển thị 1 - 9 của 78
    select
      option(value="") Trang 1
      option(value="") Trang 2
      option(value="") Trang 3
  //- End Section 7