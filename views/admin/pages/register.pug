extends ../layouts/account.pug
include ../mixins/checkbox.pug

block main
  .form-account
    h1.inner-title Đăng ký
    p.inner-desc Tạo một tài khoản để tiếp tục
    form.inner-form(id="register-form")
      .inner-group 
        label.inner-label(for="fullName") Họ tên *
        input(
          type="text" 
          id="fullName" 
          name="fullName" 
          placeholder="Nhập họ tên của bạn" 
          class="inner-control"
        )
      .inner-group 
        label.inner-label(for="email") Email *
        input(
          type="email" 
          id="email" 
          name="email" 
          placeholder="Nhập email của bạn" 
          class="inner-control"
        )
      .inner-group 
        label.inner-label(for="password") Mật khẩu *
        .inner-password
          input(
            type="password"
            id="password"
            name="password"
            placeholder="Nhập mật khẩu của bạn"
            autocomplete="current-password"
            class="inner-control"
          )
          button(
            type="button"
            class="inner-password-toggle"
            aria-label="Hiển thị mật khẩu"
          )
            i.fa-solid.fa-eye
      .inner-meta
        .inner-check
          +checkbox-30("agree", "agree")
          label(for="agree") Tôi chấp nhận các điều khoản và điều kiện
      button.inner-button Đăng ký
    .inner-more
      span Bạn đã có tài khoản? 
      a(href=`/${pathAdmin}/account/login`) Đăng nhập