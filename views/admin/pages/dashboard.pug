extends ../layouts/default.pug

block main
  if(pers.includes("dashboard-view"))
    h1.box-title Tổng quan
    //- Section 1 
    .section-1
      .inner-item
        img(src="/admin/assets/images/section-1-icon-1.svg")
        .inner-content
          .inner-text Quản trị viên
          .inner-number #{overView.totalAdmin.toLocaleString("vi-VN")}
      .inner-item
        img(src="/admin/assets/images/section-1-icon-2.svg")
        .inner-content
          .inner-text Đơn hàng
          .inner-number #{overView.totalOrder.toLocaleString("vi-VN")}
      .inner-item
        img(src="/admin/assets/images/section-1-icon-3.svg")
        .inner-content
          .inner-text Doanh thu
          .inner-number #{overView.totalRevenue.toLocaleString("vi-VN")}
    //- End Section 1

    //- Section 2
    .section-2
      .inner-head
        h2.inner-title Biểu đồ doanh thu
        input.inner-input(type="month" filter-month)
      .inner-chart
        canvas(id="revenue-chart")
    //- End Section 2

    //- Section 3
    .section-3
      h2.inner-title-main Đơn hàng mới
      .inner-table
        table
          thead
            tr
              th Mã
              th Thông tin khách
              th Danh sách tour
              th Thanh toán
              th Trạng thái
              th.text-right Ngày đặt
          tbody
            if newOrders && newOrders.length > 0
              each item in newOrders
                tr
                  td
                    .text-main #{item.code}
                  td
                    div Họ tên: #{item.fullName}
                    - var listPhone = item.phone ? (item.phone.toString().startsWith("0") ? item.phone : "0" + item.phone) : ""
                    div SĐT: #{listPhone}
                    if item.note
                      div Ghi chú: #{item.note}
                  td
                    .tour-list
                      if item.items && item.items.length > 0
                        each tour in item.items
                          .inner-item
                            img(src=tour.avatar onerror="this.src='https://placehold.co/140x100?text=No+Image'")
                            .inner-content
                              .inner-title #{tour.tourName}
                              .inner-desc
                                if tour.quantityAdult > 0
                                  div Người lớn: #{tour.quantityAdult} x #{tour.newPriceAdult.toLocaleString("vi-VN")}đ
                                if tour.quantityChildren > 0
                                  div Trẻ em: #{tour.quantityChildren} x #{tour.newPriceChildren.toLocaleString("vi-VN")}đ
                                if tour.quantityBaby > 0
                                  div Em bé: #{tour.quantityBaby} x #{tour.newPriceBaby.toLocaleString("vi-VN")}đ
                  td
                    div Tổng tiền: #{(item.subTotal || 0).toLocaleString("vi-VN")}đ
                    if item.discount > 0
                      div Giảm: #{item.discount.toLocaleString("vi-VN")}đ
                    if item.couponCode || item.coupon
                      div Mã giảm: #{item.couponCode || item.coupon}
                    div Thanh toán: #{(item.total || 0).toLocaleString("vi-VN")}đ
                    
                    - var paymentMethodItem = paymentMethodList ? paymentMethodList.find(pm => pm.value === item.paymentMethod) : null
                    div PTTT: #{paymentMethodItem ? paymentMethodItem.label : item.paymentMethod}
                    
                    - var paymentStatusItem = paymentStatusList ? paymentStatusList.find(ps => ps.value === item.paymentStatus) : null
                    div TTTT: 
                      if item.paymentStatus === 'paid'
                        b(style="color: green;") #{paymentStatusItem ? paymentStatusItem.label : item.paymentStatus}
                      else
                        b(style="color: red;") #{paymentStatusItem ? paymentStatusItem.label : item.paymentStatus}
                  td
                    - var orderStatusItem = orderStatusList ? orderStatusList.find(os => os.value === item.status) : null
                    if item.status === "success" || item.status === "done"
                      .tag.tag-green #{orderStatusItem ? orderStatusItem.label : item.status}
                    else if item.status === "cancel"
                      .tag.tag-red #{orderStatusItem ? orderStatusItem.label : item.status}
                    else
                      .tag.tag-orange #{orderStatusItem ? orderStatusItem.label : item.status}
                  td.text-right #{moment(item.createdAt).format('HH:mm - DD/MM/YYYY')}
            else
              tr
                td(colspan="6" class="text-center") Không có đơn hàng mới nào!
    //- End Section 3