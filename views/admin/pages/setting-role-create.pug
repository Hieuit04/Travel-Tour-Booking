extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  if(pers.includes("role-create"))
    h1.box-title Tạo nhóm quyền
    //- Section 8
    .section-8
      form(id="setting-role-create-form")
        .inner-group
          label(for="roleName") Tên nhóm quyền
          input(type="text" name="roleName" id="roleName")
        .inner-group
          label(for="description") Mô tả ngắn
          input(type="text" name="description" id="description")
        .inner-group
          label(for="permissions") Phân quyền
          .inner-checkbox-list
            each item in permissionList
              .inner-checkbox-item
                +checkbox-30("rolePermissions", item.value, item.value)
                label(for=item.value) #{item.label}
        .inner-group.inner-two-col.text-center
          button.btn-create(type="submit") Tạo mới
      .inner-link
        a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách
    //- End Section 8