extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  if(pers.includes("user-view"))
    h1.box-title Quản lý người dùng

    //- Section 4
    .section-4
      .inner-wrap
        .inner-item
          <i class="fa-solid fa-filter"></i> Bộ lọc
        .inner-item
          select(filter name="status")
            option(value="") Trạng thái
            each item in userStatusList
              option(value=item.value) #{item.label}
        .inner-item
          select(filter name="authType")
            option(value="") Loại tài khoản
            option(value="local") Đăng ký thường
            option(value="google") Đăng nhập Google
        .inner-item
          input(filter name="startDate" type="date")
          span -
          input(filter name="endDate" type="date")
        .inner-item.inner-reset(button-reset-filter)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      if(pers.includes("user-edit"))
        form.inner-status(change-multi data-api=`/${pathAdmin}/user/change-multi`)
          .inner-item
            select
              option(value="") -- Hành động --
              each item in userStatusList
                option(value=item.value) #{item.label}
              option(value="delete") Xóa
          .inner-item
            button(type="button") Áp dụng
      form.inner-search
        button <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm theo tên, email, SĐT" input-search)
    //- End Section 5

    //- Section 6
    .section-6
      table
        thead
          tr
            th
              +checkbox-30("check-all", "")
            th Khách hàng
            th Email
            th Số điện thoại
            th Loại tài khoản
            th Trạng thái
            th Ngày tạo
            th Hành động
        tbody
          each item in userList
            tr
              td
                +checkbox-30("check-item", "", item.id)
              td
                div(style="display: flex; align-items: center; gap: 10px;")
                  if item.avatar
                    img(src=item.avatar style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" onerror="this.src='https://placehold.co/40x40?text=U'")
                  else
                    img(src="https://placehold.co/40x40?text=U" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;")
                  .text-main #{item.fullName}
              td #{item.email}
              td
                if item.phone
                  div #{item.phone}
                else
                  span(style="color: #999;") Chưa cập nhật
              td
                if item.authType === 'google'
                  .tag.tag-orange Google
                else
                  .tag.tag-blue Thường
              td
                - var userStatusItem = userStatusList.find(s => s.value === item.status)
                if item.status === "active"
                  .tag.tag-green #{userStatusItem ? userStatusItem.label : item.status}
                else
                  .tag.tag-red #{userStatusItem ? userStatusItem.label : item.status}
              td #{moment(item.createdAt).format('HH:mm - DD/MM/YYYY')}
              td
                .inner-action
                  if(pers.includes("user-edit"))
                    a(href=`/${pathAdmin}/user/edit/${item.id}`) <i class="fa-regular fa-pen-to-square"></i>
                  if(pers.includes("user-delete"))
                    a(
                      href="javascript:;" 
                      class="inner-remove"
                      button-delete
                      data-api=`/${pathAdmin}/user/delete/${item.id}` 
                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7
      if userList.length > 0
        .inner-text Hiển thị #{pagination.skip+1} - #{pagination.skip + userList.length} của #{pagination.totalRecord}
        select(pagination)
          - for(let i=1; i<= pagination.totalPages; i++)
            option(value=i) Trang #{i}
      else
        .inner-text Không tìm thấy khách hàng nào!
    //- End Section 7
