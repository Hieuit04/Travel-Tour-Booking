extends ../layouts/default.pug
include ../mixins/checkbox.pug
include ../mixins/select-tree.pug

block main
  h1.box-title Edit tour

  //- Section 8
  .section-8
    form(id="tour-edit-form")
      input(type="hidden" name="id" value=tourDetail.id)
      .inner-group
        label(for="tourName") Tên tour
        input(type="text" name="tourName" id="tourName" value=tourDetail.tourName)
      .inner-group
        label(for="category") Danh mục
        select(name="category" id="category")
          option(value="") -- Chọn danh mục --
          if categoryTree
            +select-tree(categoryTree, 1 , tourDetail.category)
      .inner-group
        label(for="position") Vị trí
        input(type="number" name="position" id="position" value=tourDetail.position)
      .inner-group
        label(for="status") Trạng thái
        select(name="status" id="status")
          option(value="active" selected=(tourDetail.status == "active" ? true:false)) Hoạt động                          
          option(value="inactive" selected=(tourDetail.status == "inactive" ? true:false)) Tạm dừng
      .inner-group.inner-two-col
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" accept="image/*" filepondImage image-default=tourDetail.avatar).inner-upload-image
      .inner-group
        label(for="") Giá cũ
        .inner-input-list
          .inner-input-item
            label(for="priceAdult") Người lớn
            input(type="number" name="priceAdult" id="priceAdult" value=tourDetail.priceAdult)
          .inner-input-item
            label(for="priceChildren") Trẻ em
            input(type="number" name="priceChildren" id="priceChildren" value=tourDetail.priceChildren)
          .inner-input-item
            label(for="priceBaby") Em bé
            input(type="number" name="priceBaby" id="priceBaby" value=tourDetail.priceBaby)
      .inner-group
        label(for="") Giá mới
        .inner-input-list
          .inner-input-item
            label(for="newPriceAdult") Người lớn
            input(type="number" name="newPriceAdult" id="newPriceAdult" value=tourDetail.newPriceAdult)
          .inner-input-item
            label(for="newPriceChildren") Trẻ em
            input(type="number" name="newPriceChildren" id="newPriceChildren" value=tourDetail.newPriceChildren)
          .inner-input-item
            label(for="newPriceBaby") Em bé
            input(type="number" name="newPriceBaby" id="newPriceBaby" value=tourDetail.newPriceBaby)
      .inner-group
        label(for="") Còn lại
        .inner-input-list
          .inner-input-item
            label(for="stockAdult") Người lớn
            input(type="number" name="stockAdult" id="stockAdult" value=tourDetail.stockAdult)
          .inner-input-item
            label(for="stockChildren") Trẻ em
            input(type="number" name="stockChildren" id="stockChildren" value=tourDetail.stockChildren)
          .inner-input-item
            label(for="stockBaby") Em bé
            input(type="number" name="stockBaby" id="stockBaby" value=tourDetail.stockBaby)
      .inner-group
        label(for="") Những địa điểm có tour
        .inner-checkbox-list
          each item in cityList
            .inner-checkbox-item
              +checkbox-30("locations", `location-${item.id}`, item.id, tourDetail.loaction && tourDetail.loaction.includes(item.id.toString()))
              label(for=`location-${item.id}`) #{item.name}
      .inner-group
        label(for="time") Thời gian
        input(type="text" name="time" id="time" value=tourDetail.time)
      .inner-group
        label(for="vehicle") Phương tiện
        input(type="text" name="vehicle" id="vehicle" value=tourDetail.vihicle)
      .inner-group
        label(for="departureDate") Ngày khởi hành
        input(type="date" name="departureDate" id="departureDate" value=tourDetail.departureDateFormat)
      .inner-group.inner-two-col
        label(for="information") Thông tin tour
        textarea(name="information" id="information" textarea-mce) #{tourDetail.information}
      .inner-group.inner-two-col
        label(for="") Lịch trình tour
        .inner-schedule
          .inner-schedule-list
            each schedule in tourDetail.schedule
              .inner-schedule-item
                .inner-schedule-head
                  .inner-schedule-button.inner-move
                    <i class="fa-solid fa-arrows-up-down-left-right"></i>
                  input(type="text" value=schedule.title) 
                  .inner-schedule-button.inner-remove
                    <i class="fa-regular fa-trash-can"></i>
                  .inner-schedule-button.inner-more
                    <i class="fa-solid fa-angle-down"></i>
                .inner-schedule-body
                  textarea(textarea-mce) #{schedule.content}
          .inner-schedule-create + Thêm lịch trình
      .inner-group.inner-two-col.text-center
        button.btn-create(type="submit") Cập nhật 
    .inner-link
      a(href= `/${pathAdmin}/tour/list`) Quay lại danh sách
  //- End Section 8