extends ../layouts/default.pug
include ../mixins/checkbox.pug


block main
  h1.box-title Thùng rác tour

  //- Section 5
  .section-5
    form.inner-status(change-multi data-api=`/${pathAdmin}/tour/change-multi`)
      .inner-item
        select
          option(value="") -- Hành động --
          option(value="restore") Khôi phục
          option(value="delete-destroy") Xóa vĩnh viễn
      .inner-item
        button Áp dụng
    form.inner-search
      button <i class="fa-solid fa-magnifying-glass"></i>
      input(type="text" placeholder="Tìm kiếm")
  //- End Section 5

  //- Section 6
  .section-6
    table
      thead
        tr
          th
            +checkbox-30("check-all", "")
          th Tên tour
          th Ảnh đại diện
          th Giá
          th Còn lại
          th Vị trí
          th Trạng thái
          th Tạo bởi
          th Xóa bởi
          th Hành động
      tbody
        each item in tourList 
          tr
            td
              +checkbox-30("check-item", "",item.id)
            td #{item.tourName}
            td
              img(src=item.avatar class="inner-avatar")
            td
              div NL: #{item.newPriceAdult.toLocaleString("vi-VN")}đ
              div TE: #{item.newPriceChildren.toLocaleString("vi-VN")}đ
              div EB: #{item.newPriceBaby.toLocaleString("vi-VN")}đ
            td
              div NL: #{item.stockAdult}
              div TE: #{item.stockChildren}
              div EB: #{item.stockBaby}
            td #{item.position}
            td
              if(item.status == "active")
                .tag.tag-green Hoạt động
              else if(item.status == "inactive")
                .tag.tag-red Tạm dừng
            td
              div #{item.createdByName}
              .inner-time #{item.createdAtFormat}
            td
              div #{item.deletedByName}
              .inner-time #{item.deletedAtFormat}
            td
              .inner-action
                a(
                  href="javascript:;" 
                  class="inner-restore"
                  button-restore
                  data-api=`/${pathAdmin}/tour/restore/${item.id}`
                ) <i class="fa-solid fa-rotate-left"></i>
                a(
                  title="Xóa vĩnh viễn"
                  href="javascript:;" 
                  class="inner-remove"
                  button-delete
                  data-api=`/${pathAdmin}/tour/delete-destroy/${item.id}`
                ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    .inner-text Hiển thị 1 - 9 của 78
    select
      option(value="") Trang 1
      option(value="") Trang 2
      option(value="") Trang 3
  //- End Section 7