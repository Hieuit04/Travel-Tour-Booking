extends ../layouts/default.pug

block main
  if(pers.includes("order-edit"))
    h1.box-title Đơn hàng: #{orderDetail.code}

    //- Section 8
    .section-8
      form(id="order-edit-form" data-api=`/${pathAdmin}/order/edit/${orderDetail.id}`)
        .inner-group
          label(for="fullName") Tên khách hàng
          input(type="text" name="fullName" id="fullName" value=orderDetail.fullName)
        .inner-group
          label(for="phone") Số điện thoại
          - var displayPhone = orderDetail.phone.toString().startsWith("0") ? orderDetail.phone : "0" + orderDetail.phone
          input(type="text" name="phone" id="phone" value=displayPhone)
        .inner-group.inner-two-col
          label(for="note") Ghi chú
          textarea(name="note" id="note") #{orderDetail.note}
        .inner-group
          label(for="paymentMethod") Phương thức thanh toán
          select(name="paymentMethod" id="paymentMethod")
            each item in paymentMethodList
              option(value=item.value selected=(orderDetail.paymentMethod === item.value)) #{item.label}
        .inner-group
          label(for="paymentStatus") Trạng thái thanh toán
          select(name="paymentStatus" id="paymentStatus")
            each item in paymentStatusList
              option(value=item.value selected=(orderDetail.paymentStatus === item.value)) #{item.label}
        .inner-group
          label(for="orderDate") Ngày đặt
          input(type="text" id="orderDate" value=moment(orderDetail.createdAt).format('HH:mm - DD/MM/YYYY') readonly disabled)
        .inner-group
          label(for="status") Trạng thái
          select(name="status" id="status")
            each item in orderStatusList
              option(value=item.value selected=(orderDetail.status === item.value)) #{item.label}
        .inner-group
          label(for="") Danh sách tour
          .tour-list.inner-large
            each item in orderDetail.items
              .inner-item
                img(src=item.avatar onerror="this.src='https://placehold.co/140x100?text=No+Image'")
                .inner-content
                  .inner-title #{item.tourName}
                  .inner-desc
                    if item.quantityAdult > 0
                      div Người lớn: #{item.quantityAdult} x #{item.newPriceAdult.toLocaleString("vi-VN")}đ
                    if item.quantityChildren > 0
                      div Trẻ em: #{item.quantityChildren} x #{item.newPriceChildren.toLocaleString("vi-VN")}đ
                    if item.quantityBaby > 0
                      div Em bé: #{item.quantityBaby} x #{item.newPriceBaby.toLocaleString("vi-VN")}đ
                    div Ngày khởi hành: #{moment(item.departureDate).format('DD/MM/YYYY')}
                    if item.cityName
                      div Khởi hành tại: #{item.cityName}
        .inner-group
          label(for="") Thanh toán
          .inner-text
            div Tổng tiền: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
            div Giảm: #{orderDetail.discount.toLocaleString("vi-VN")}đ
            div Thanh toán: <span class="text-red">#{orderDetail.total.toLocaleString("vi-VN")}đ</span>
        .inner-group.inner-two-col.text-center
          button.btn-create(type="submit") Cập nhật
      .inner-link
        a(href=`/${pathAdmin}/order/list`) Quay lại danh sách
    //- End Section 8
