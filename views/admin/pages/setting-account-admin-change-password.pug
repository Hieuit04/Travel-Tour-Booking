extends ../layouts/default.pug

block main
  h1.box-title #{pageTitle}

  //- Section 8
  .section-8
    form(id="setting-account-admin-change-password-form")
      input(type="hidden" name="id" value=accountAdminDetail.id)
      .inner-group
        label(for="fullName") Họ tên *
        input(type="text" name="fullName" id="fullName" value=accountAdminDetail.fullName readonly)
      .inner-group
        label(for="email") Email *
        input(type="email" name="email" id="email" value=accountAdminDetail.email readonly)
      .inner-group
        label(for="passWord") Mật khẩu mới *
        input(type="text" name="passWord" id="passWord")
      .inner-group.inner-two-col.text-center
        button.btn-create(type="submit") Đổi mật khẩu
    .inner-link
      a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách
  //- End Section 8