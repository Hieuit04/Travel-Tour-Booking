nav.sider
  .inner-list
    if(pers.includes("dashboard-view"))
      a.inner-item(href=`/${pathAdmin}/dashboard`)
        img(src="/admin/assets/images/icon-sider-1.svg")
        span Tổng quan
    if(pers.includes("category-view"))
      a.inner-item(href=`/${pathAdmin}/category/list`)
        img(src="/admin/assets/images/icon-sider-2.svg")
        span Quản lý danh mục
    if(pers.includes("tour-view"))
      a.inner-item(href=`/${pathAdmin}/tour/list`)
        img(src="/admin/assets/images/icon-sider-3.svg")
        span Quản lý tour
    if(pers.includes("promotion-view"))
      a.inner-item(href=`/${pathAdmin}/promotion/list`)
        i.fa-solid.fa-percent
        span Quản lý khuyến mãi

    a.inner-item(href=`/${pathAdmin}/order/list`)
      img(src="/admin/assets/images/icon-sider-4.svg")
      span Quản lý đơn hàng
    a.inner-item(href=`/${pathAdmin}/user/list`)
      img(src="/admin/assets/images/icon-sider-5.svg")
      span Quản lý người dùng
    if(pers.includes("contact-view"))
      a.inner-item(href=`/${pathAdmin}/contact/list`)
        img(src="/admin/assets/images/icon-sider-6.svg")
        span Thông tin liên hệ
  .inner-line
  .inner-list
    if(pers.includes("website-info-view") || pers.includes("account-admin-view") || pers.includes("role-list-view"))
      a.inner-item(href=`/${pathAdmin}/setting/list`)
        img(src="/admin/assets/images/icon-sider-7.svg")
        span Cài đặt chung
    a.inner-item(href=`/${pathAdmin}/profile/edit`)
      img(src="/admin/assets/images/icon-sider-5.svg")
      span Thông tin cá nhân
    a.inner-item.inner-logout(href=`/${pathAdmin}/account/logout`)
      img(src="/admin/assets/images/icon-sider-8.svg")
      span Đăng xuất