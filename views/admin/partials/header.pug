header.header
  .inner-left
    a.inner-logo(href=`/${pathAdmin}/dashboard`)
      span 28
      span Admin
  .inner-right
    .inner-notify
      img(src="/admin/assets/images/icon-bell.svg")
      span 6
    .inner-account
      img(src=account.avatar)
      .inner-text
        .inner-name #{account.fullName}
        .inner-role #{role.roleName}|
    .inner-button-menu
      i.fas.fa-bars